{
  "version": 2,
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10,
      "includeFiles": "app/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://cdn.jsdelivr.net https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https://*.supabase.co blob: data:; connect-src 'self' https://*.iamlearningarabic.com https://*.supabase.co https://api.stripe.com https://api.brevo.com wss://*.supabase.co; frame-src https://js.stripe.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(fille|garcon|adulte|girl|boy|adult|cours|app|admin)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(fille|garcon|adulte|girl|boy|adult|cours|app|admin)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(accueil|connexion|inscription|interface|paiement)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/connexion",
      "destination": "/index.html"
    },
    {
      "source": "/inscription",
      "destination": "/index.html"
    },
    {
      "source": "/paiement",
      "destination": "/index.html"
    },
    {
      "source": "/accueil",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/api/app?suite=/app"
    },
    {
      "source": "/banc",
      "destination": "/api/app?suite=/banc&banc=1"
    },
    {
      "source": "/interface",
      "destination": "/api/app?suite=/interface"
    },
    {
      "source": "/fille",
      "destination": "/api/app?suite=/fille"
    },
    {
      "source": "/garcon",
      "destination": "/api/app?suite=/garcon"
    },
    {
      "source": "/adulte",
      "destination": "/api/app?suite=/adulte"
    },
    {
      "source": "/girl",
      "destination": "/api/app?suite=/girl"
    },
    {
      "source": "/boy",
      "destination": "/api/app?suite=/boy"
    },
    {
      "source": "/adult",
      "destination": "/api/app?suite=/adult"
    },
    {
      "source": "/app/:chemin*",
      "destination": "/api/app?suite=/app/:chemin*"
    },
    {
      "source": "/fille/:chemin*",
      "destination": "/api/app?suite=/fille/:chemin*"
    },
    {
      "source": "/garcon/:chemin*",
      "destination": "/api/app?suite=/garcon/:chemin*"
    },
    {
      "source": "/adulte/:chemin*",
      "destination": "/api/app?suite=/adulte/:chemin*"
    },
    {
      "source": "/girl/:chemin*",
      "destination": "/api/app?suite=/girl/:chemin*"
    },
    {
      "source": "/boy/:chemin*",
      "destination": "/api/app?suite=/boy/:chemin*"
    },
    {
      "source": "/adult/:chemin*",
      "destination": "/api/app?suite=/adult/:chemin*"
    },
    {
      "source": "/cours/:chemin*",
      "destination": "/api/app?suite=/cours/:chemin*"
    },
    {
      "source": "/admin/:chemin*",
      "destination": "/api/app?suite=/admin/:chemin*"
    }
  ],
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 6 * * *"
    }
  ]
}
